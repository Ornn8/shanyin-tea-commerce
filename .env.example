# Local development database (matches docker-compose.yml)
DATABASE_URL="postgresql://shanyin:shanyin@localhost:5432/shanyin?schema=public"

# Name of the cookie that persists the visitor's locale choice
SHANYIN_LOCALE_COOKIE="shanyin_locale"

# --- Merchant administration (Issue #3, ADR-0005) ---
# The single allowlisted merchant administrator created by `pnpm db:seed`.
# These are local demo credentials; production must rotate them and store
# secrets outside the repository. Public registration is disabled, so this
# seeded account is the only way into /admin.
ADMIN_EMAIL="merchant@shanyin.example"
ADMIN_PASSWORD="change-me-shanyin-demo-2026"

# Secret used to sign the admin session cookie (better-auth). Keep it long
# and random in production. In production, also set BETTER_AUTH_URL to the
# public origin (e.g. https://shop.example.com).
AUTH_SECRET="dev-secret-shanyin-tea-4f2d1a77c3f8-change-r4"