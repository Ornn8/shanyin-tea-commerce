# Local development database (matches docker-compose.yml)
DATABASE_URL="postgresql://shanyin:shanyin@localhost:5432/shanyin?schema=public"

# Name of the cookie that persists the visitor's locale choice
SHANYIN_LOCALE_COOKIE="shanyin_locale"

# --- Merchant administration (Issue #3, ADR-0005) ---
# The single allowlisted merchant administrator created by `pnpm db:seed`.
# These are local demo credentials; production must rotate them and store
# secrets outside the repository. Public registration is disabled, so this
# seeded account is the only way into /admin.
ADMIN_EMAIL="merchant@shanyin.example"
ADMIN_PASSWORD="change-me-shanyin-demo-2026"

# Secret used to sign the admin session cookie (better-auth). Keep it long
# and random in production. In production, also set BETTER_AUTH_URL to the
# public origin (e.g. https://shop.example.com).
AUTH_SECRET="dev-secret-shanyin-tea-4f2d1a77c3f8-change-r4"

# Secret used to sign the anonymous cart cookie (Issue #5, ADR-0007). Long
# and random in production. When unset, AUTH_SECRET is used as the local
# fallback.
CART_SECRET="dev-secret-shanyin-cart-4f2d1a77c3f8-change-r5"

# --- Public origin for canonical/hreflang/JSON-LD URLs (ADR-0006) ---
# Trusted absolute public origin (e.g. https://shop.example.com). When set,
# canonical links and structured data use it and forwarded request headers
# are never trusted. Leave unset only for local development, where only
# localhost/127.0.0.1 hosts are honored from headers.
# PUBLIC_SITE_URL="https://shop.example.com"

# --- Pilot checkout & payments (Issue #6, ADR-0008) ---
# Secret that SIGNS the deterministic simulated payment gateway events used by
# CI and local demos. Test/simulation only — it can never enable a live charge.
# When unset, AUTH_SECRET is used as the local fallback.
PAYMENT_SIM_SECRET="dev-secret-shanyin-sim-payment-4f2d1a77c3f8-change-r6"

# Optional Stripe TEST-MODE adapter (dormant unless all three are set AND the
# key is a test key — live charges are forbidden in this slice). With these
# unset, checkout runs entirely on the simulated gateway. Never paste live keys.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
