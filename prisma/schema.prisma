// Shanyin Tea — demo storefront data model.
//
// Commerce facts (identifiers, prices, inventory, origin, leaf form,
// caffeine level) are stored once and language-neutral. Localized copy lives
// in the *Localization tables and is keyed by locale id from the i18n registry
// (zh-CN | en | ja).
//
// Merchant administration (Issue #3, ADR-0005):
// - Products own shared facts plus a `published` lifecycle state and one or
//   more language-neutral variants (SKU, price in integer CNY cents,
//   inventory). Inventory is per variant and shared across every locale.
// - `User`/`Session`/`Account`/`Verification` back the maintained
//   authentication library (better-auth). Public sign-up is disabled; the
//   seed creates the single allowlisted merchant administrator.
// - `AuditLog` records every mutation (actor, timestamp, entity,
//   before/after summary) and never stores secrets.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Leaf form of the tea — a language-neutral product fact (demo placeholder).
enum ProductForm {
  LOOSE
  COMPRESSED
}

/// Caffeine level — a language-neutral product fact (demo placeholder).
enum CaffeineLevel {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  sortOrder     Int                     @default(0)
  products      Product[]
  localizations CategoryLocalization[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model CategoryLocalization {
  categoryId String
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@index([locale])
}

model Product {
  id            String               @id @default(cuid())
  slug          String               @unique
  origin        String
  form          ProductForm          @default(LOOSE)
  caffeine      CaffeineLevel        @default(MEDIUM)
  categoryId    String
  category      Category             @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  localizations ProductLocalization[]
  /// Publication lifecycle state (ADR-0005): only published products are
  /// visible on the storefront.
  published     Boolean              @default(false)
  publishedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([categoryId])
}

/// A language-neutral sellable unit of a product. Price is stored as integer
/// minor units of CNY (`priceCents`); inventory is a non-negative integer
/// shared by every locale (never localized).
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Globally unique SKU — publishing rejects duplicates.
  sku        String   @unique
  /// Shared display name (e.g. package size); not localized copy.
  name       String
  priceCents Int
  inventory  Int      @default(0)
  /// Deterministic variant order within the product (0 = the storefront
  /// default). `createdAt` is transaction-stable in PostgreSQL (CURRENT_-
  /// TIMESTAMP = transaction start), so without this explicit position rows
  /// created together would tie on `createdAt` and SQL would provide no
  /// deterministic order — the default SKU, price, and availability would
  /// become nondeterministic (ADR-0006). Every write path stores the
  /// merchant's variant order as 0-based positions.
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, position])
}

model ProductLocalization {
  productId      String
  locale         String
  name           String
  description    String
  tastingNotes   String
  /// Optional localized copy (falls back to English in preview, ADR-0003/0005).
  brewingNotes   String?
  seoTitle       String?
  seoDescription String?
  mediaAlt       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Merchant administration authentication (better-auth, ADR-0005).
// Model and field names are the adapter contract; keep them as-is.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Scrypt hash; never logged or returned to clients.
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Mutation audit trail (ADR-0005). `before`/`after` hold JSON summaries of
// product data only — never secrets (passwords, tokens, sessions).
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  /// Action id, e.g. "product.create", "product.publish", "variant.inventory".
  action     String
  entityType String
  entityId   String?
  actorEmail String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Pilot checkout, idempotent orders, and secure customer lookup (Issue #6,
// ADR-0008).
// ---------------------------------------------------------------------------

/// Lifecycle of a checkout order (ADR-0008). The state machine is explicit:
/// `pending` is the only open state, created when the shopper submits the
/// checkout form; a VERIFIED gateway event moves it to a terminal state. A
/// browser redirect is never payment authority — only a processed,
/// replay-safe gateway event changes payment state, and stock is decremented
/// exactly once when a `succeeded` event applies to a `pending` order.
enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

model Order {
  id         String      @id @default(cuid())
  /// Human-readable, non-sequential order number (e.g. SHY-7K2M9QX4D3).
  orderNumber String     @unique
  status     OrderStatus @default(PENDING)
  /// Currency of record — CNY for every order (ADR-0003). Unchanged by locale.
  currency   String      @default("CNY")
  subtotalCents Int
  shippingFeeCents Int
  totalCents Int

  /// Minimum documented contact + shipping fields (ADR-0008), validated
  /// server-side. The SHA-256 hash of the high-entropy lookup credential is
  /// the ONLY stored secret-bearing field — see `lookupHash`.
  email          String
  recipientName  String
  addressLine1   String
  city           String
  region         String
  postalCode     String
  countryCode    String

  /// SHA-256 hex of the high-entropy lookup credential. The plaintext
  /// credential is never stored and is shown to the shopper exactly once at
  /// confirmation; order existence is not enumerable through any other key.
  lookupHash    String      @unique
  /// Client-provided submission idempotency key (ADR-0008). One checkout
  /// submission maps to exactly one order: replaying the same key returns the
  /// existing order instead of creating a duplicate (and duplicate personal
  /// data) for one checkout.
  submissionKey String      @unique
  /// Payment gateway reference. `simulated` in CI; optionally `stripe-test`.
  gateway       String      @default("simulated")
  /// The gateway's payment intent id — the one value that ties gateway events
  /// to this order.
  providerIntentId String    @unique
  /// Localized reason for a `FAILED` payment (stock shortage or gateway).
  failureReason String?
  paidAt        DateTime?

  lines  OrderLine[]
  events PaymentEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// An immutable snapshot of one sellable unit at checkout time (ADR-0008).
/// The SKU stays language-neutral, but the localized display name is copied
/// into `nameZhCn`/`nameEn`/`nameJa` so the order's meaning never changes when
/// the catalog copy is later edited. Prices are integer CNY cents captured
/// from the server at checkout time — never client-supplied, never re-read
/// from the catalog after the order exists.
model OrderLine {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sku           String
  /// Package-size display snapshot (e.g. "100g"); not localized copy.
  variantName   String
  /// Localized product-name snapshots in every registered locale.
  nameZhCn      String
  nameEn        String
  nameJa        String
  unitPriceCents Int
  quantity      Int
  subtotalCents Int
  currency      String @default("CNY")

  @@index([orderId])
  @@index([sku])
}

/// One processed gateway event for an order (ADR-0008). Every signature-valid
/// event for a known intent is recorded exactly once — `providerEventId` is
/// the idempotency key — so duplicate or reordered deliveries can never create
/// a duplicate order or double-decrement stock. `resultStatus` is the order
/// status AFTER the event was applied (the current status when the event was a
/// safe state-machine no-op). No secret or raw payload is ever stored.
model PaymentEvent {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway           String
  eventType         String
  /// The gateway's unique event id (idempotency key, scoped per gateway).
  providerEventId   String
  /// Gateway-reported event timestamp (epoch seconds), for reordering audits.
  eventCreatedAt    DateTime?
  /// Recorded fact (never the payload itself): was the signature verified?
  signatureVerified Boolean
  /// The order status this event produced (or the current status when ignored).
  resultStatus      OrderStatus
  processedAt       DateTime  @default(now())

  @@unique([gateway, providerEventId])
  @@index([orderId])
}
